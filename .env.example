# --- Database (Supabase Postgres, free tier) ---
# Supabase Project Settings > Database > Connection string > URI (use the "Transaction" pooler on 6543 for serverless)
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres"

# --- Auth (single-user password gate) ---
# Generate a bcrypt-style hash of your chosen password and paste it here. See DEPLOY.md.
AUTH_PASSWORD_HASH=""
# Long random secret used to sign the session cookie. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=""

# --- MCP server (Coach AI connector) ---
# Long random bearer token required on every request to /api/mcp. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=""

# --- Canvas LMS (School module — optional, app works without it) ---
# Your school's Canvas URL, no trailing slash.
CANVAS_BASE_URL=""
# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_ACCESS_TOKEN=""

# --- Nutrition (optional — falls back to USDA's public DEMO_KEY, ~30 req/hour) ---
# Free 2-minute signup, no payment: https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=""

# --- AI macro estimation (optional — Quick Log falls back to regex+USDA
# matching when this is empty or the call fails, so the feature never breaks) ---
# Free tier signup, no payment: https://console.groq.com/keys
GROQ_API_KEY=""

# --- Strava export (optional — see STRAVA_SETUP.md. Absent, the "Send to
# Strava" button on session-import just never renders, nothing else changes) ---
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REFRESH_TOKEN=""

# --- Personal OS merge: Brain embeddings (Google Generative Language API,
# free tier — src/lib/ai/embed.ts returns null and callers fall back to a
# non-AI path when this is empty, so the app never breaks without it) ---
# Free key, no payment: https://aistudio.google.com
GEMINI_API_KEY=""

# --- Personal OS merge: Telegram capture pipeline ---
# Telegram -> @BotFather -> /newbot -> save the token it gives you
TELEGRAM_BOT_TOKEN=""
# Random secret Telegram echoes back on every webhook call, so the endpoint
# can verify a request really came from Telegram. Generate: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=""
# Telegram -> @userinfobot -> your numeric user ID. Locks the bot to you only.
TELEGRAM_USER_ID=""

# --- Personal OS merge: nightly journal rollup cron ---
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET` on
# its own cron-triggered requests once the env var is set. Generate: openssl rand -hex 16
CRON_SECRET=""

# --- Personal OS merge: Google Calendar overlay ---
# Google Calendar -> Settings -> your calendar -> "Secret address in iCal
# format". Unset -> the Home calendar card shows a clean "connect your
# calendar" state, never an error (src/app/api/calendar/route.ts).
GOOGLE_CALENDAR_ICAL_URL=""

# --- App ---
NEXT_PUBLIC_APP_TZ="Asia/Manila"
