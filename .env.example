# --- Database (Supabase Postgres, free tier) ---
# Supabase Project Settings > Database > Connection string > URI (use the "Transaction" pooler on 6543 for serverless)
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres"

# --- Auth (single-user password gate) ---
# Generate a bcrypt-style hash of your chosen password and paste it here. See DEPLOY.md.
AUTH_PASSWORD_HASH=""
# Long random secret used to sign the session cookie. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=""

# --- MCP server (Coach AI connector) ---
# Long random bearer token required on every request to /api/mcp. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=""

# --- Canvas LMS (School module — optional, app works without it) ---
# Your school's Canvas URL, no trailing slash.
CANVAS_BASE_URL=""
# Canvas -> Account -> Settings -> "+ New Access Token"
CANVAS_ACCESS_TOKEN=""

# --- Nutrition (optional — falls back to USDA's public DEMO_KEY, ~30 req/hour) ---
# Free 2-minute signup, no payment: https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_TZ="Asia/Manila"
